{
  "expo": {
    "name": "SRG",
    "slug": "SRG",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Sky Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "srg",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.SRG",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need access to your microphone to enable voice search for games.",
        "NSSpeechRecognitionUsageDescription": "We need access to speech recognition to convert your voice to text for searching games."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Sky Logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.SRG"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes for games."
        }
      ]
    ]
  }
}
